/* ---------- LIVE ATTENDANCE ---------- */
async function viewLive(){
  $('#view').innerHTML='<p class="empty">Loading live attendance...</p>';
  const d=await get('live_attendance');
  const active=d.list.filter(e=>e.punched), not=d.list.filter(e=>!e.punched);
  $('#view').innerHTML=`
    <div class="grid g2">
      <div class="card"><h3 style="margin-bottom:12px;color:#00b894">🟢 Clocked In (${active.length})</h3>
        <table><thead><tr><th>Employee</th><th>In</th><th>Out</th><th>Status</th></tr></thead>
        <tbody>${active.map(e=>`<tr><td><b>${esc(e.full_name)}</b> <span style="color:#8a97ab;font-size:12px">· ${esc(e.dept||'')}</span></td><td>${e.in||'-'}</td><td>${e.out||'-'}</td><td>${pill(e.ar_status||'Present')}</td></tr>`).join('')}</tbody></table></div>
      <div class="card"><h3 style="margin-bottom:12px;color:#8a97ab">⏳ Not Yet Clocked (${not.length})</h3>
        <table><thead><tr><th>Employee</th><th>Dept</th></tr></thead>
        <tbody>${not.map(e=>`<tr><td><b>${esc(e.full_name)}</b></td><td>${esc(e.dept||'-')}</td></tr>`).join('')}</tbody></table></div>
    </div>`;
}

/* ---------- CLOCK IN/OUT ---------- */
async function viewClock(){
  const d=await get('employees');
  $('#view').innerHTML=`
    <div class="card" style="max-width:520px;margin:0 auto;text-align:center">
      <h3 style="margin-bottom:18px">🕐 Clock In / Clock Out</h3>
      <div style="margin-bottom:16px"><label>Select Employee</label><select id="ckEmp">${d.list.map(e=>`<option value="${e.id}">${esc(e.full_name)}</option>`).join('')}</select></div>
      <div style="display:flex;gap:12px;justify-content:center">
        <button class="btn green" onclick="goClock('clock_in')"><i class="fa-solid fa-right-to-bracket"></i> Clock In</button>
        <button class="btn red" onclick="goClock('clock_out')"><i class="fa-solid fa-right-from-bracket"></i> Clock Out</button>
      </div>
      <p style="color:#8a97ab;font-size:12px;margin-top:14px">Clocking machine is the source of raw transactions; manual app entries are logged as 'App'.</p>
    </div>`;
}
async function goClock(a){const eid=$('#ckEmp').value;if(!eid){alert('Select employee');return;}try{const r=await post(a,{employee_id:eid});alert(a==='clock_in'?('Clocked in '+r.status):('Clocked out. Worked '+(r.worked_minutes||0)+' min, OT '+(r.overtime_minutes||0)+' min'));}catch(e){alert(e.message);}}

/* ---------- EMPLOYEES ---------- */
async function viewEmps(){
  const d=await get('employees');
  $('#view').innerHTML=`<div class="card"><div class="filter-row"><input placeholder="Search..." id="es"> <button class="btn ghost" onclick="viewEmps()">Refresh</button></div>
    <div class="table-wrap"><table><thead><tr><th>ID</th><th>Name</th><th>Dept</th><th>Position</th><th>Status</th></tr></thead>
    <tbody id="etb">${d.list.map(e=>`<tr><td>${esc(e.employee_code)}</td><td><b>${esc(e.full_name)}</b></td><td>${esc(e.dept||'-')}</td><td>${esc(e.position||'-')}</td><td>${pill(e.status)}</td></tr>`).join('')}</tbody></table></div></div>`;
}

/* ---------- SHIFTS & SCHEDULES ---------- */
async function viewShifts(){
  const s=await get('shifts');const emps=await get('employees');
  $('#view').innerHTML=`
    <div class="grid g2">
      <div class="card"><h3 style="margin-bottom:12px;color:#37455e">Shifts</h3>
        <button class="btn sm green" style="margin-bottom:10px" onclick="openShift()">+ Add Shift</button>
        <table><thead><tr><th>Shift</th><th>Start</th><th>End</th><th>Grace</th><th></th></tr></thead>
        <tbody>${s.list.map(x=>`<tr><td><b>${esc(x.name)}</b></td><td>${x.start_time.slice(0,5)}</td><td>${x.end_time.slice(0,5)}</td><td>${x.grace_minutes}min</td><td><button class="btn sm red" onclick="delShift(${x.id})"><i class="fa-regular fa-trash-can"></i></button></td></tr>`).join('')}</tbody></table></div>
      <div class="card"><h3 style="margin-bottom:12px;color:#37455e">Assign Schedule</h3>
        <div class="form-grid"><div><label>Employee</label><select id="schEmp">${emps.list.map(e=>`<option value="${e.id}">${esc(e.full_name)}</option>`).join('')}</select></div>
        <div><label>Shift</label><select id="schShift">${s.list.map(x=>`<option value="${x.id}">${esc(x.name)} (${x.start_time.slice(0,5)})</option>`).join('')}</select></div>
        <div><label>Effective Date</label><input type="date" id="schDate" value="${new Date().toISOString().slice(0,10)}"></div></div>
        <div style="margin-top:12px"><button class="btn" onclick="assignSch()">Assign</button></div></div>
    </div>`;
}
function openShift(){
  openModal(`<h3>New Shift</h3><div class="form-grid">
    <div><label>Shift Name</label><input id="shName"></div><div><label>Grace (min)</label><input id="shGrace" type="number" value="5"></div>
    <div><label>Start</label><input id="shStart" type="time"></div><div><label>End</label><input id="shEnd" type="time"></div></div>
    <div style="margin-top:14px"><button class="btn" onclick="saveShift()">Save</button></div>`);
}
async function saveShift(){await post('save_shift',{name:$('#shName').value,start_time:$('#shStart').value,end_time:$('#shEnd').value,grace_minutes:$('#shGrace').value});closeModal();viewShifts();}
async function assignSch(){await post('assign_schedule',{employee_id:$('#schEmp').value,shift_id:$('#schShift').value,effective_date:$('#schDate').value});alert('Schedule assigned');viewShifts();}
async function delShift(id){if(!confirm('Delete this shift?'))return;await post('delete_shift',{id});viewShifts();}

/* ---------- LATE ARRIVALS ---------- */
async function viewLate(){
  const d=await get('late_arrivals');
  $('#view').innerHTML=`<div class="card"><h3 style="margin-bottom:12px;color:#f39c12">🟡 Late Arrivals</h3>
    <table><thead><tr><th>Date</th><th>Employee</th><th>Dept</th><th>Clock In</th><th>Status</th></tr></thead>
    <tbody>${(d.list||[]).map(r=>`<tr><td>${fmtDate(r.work_date)}</td><td><b>${esc(r.full_name)}</b></td><td>${esc(r.dept||'-')}</td><td>${fmtDT(r.clock_in)}</td><td>${pill(r.status)}</td></tr>`).join('')||'<tr><td colspan="5" class="empty">No late arrivals</td></tr>'}</tbody></table></div>`;
}

/* ---------- ABSENCES ---------- */
async function viewAbs(){
  const d=await get('absences');
  $('#view').innerHTML=`<div class="card"><h3 style="margin-bottom:12px;color:#d63031">🔴 Absences (this month)</h3>
    <table><thead><tr><th>Employee</th><th>Dept</th><th>Present</th><th>Absent</th></tr></thead>
    <tbody>${(d.list||[]).filter(e=>e.absent).map(e=>`<tr><td><b>${esc(e.full_name)}</b></td><td>${esc(e.dept||'-')}</td><td>${e.present_days}</td><td style="color:#d63031;font-weight:700">${e.absent_days}</td></tr>`).join('')||'<tr><td colspan="4" class="empty">No absences</td></tr>'}</tbody></table></div>`;
}

/* ---------- LEAVE ---------- */
async function viewLeave(){
  const d=await get('leave');
  $('#view').innerHTML=`<div class="card"><h3 style="margin-bottom:12px;color:#37455e">🏖 Leave Requests</h3>
    <table><thead><tr><th>Employee</th><th>Type</th><th>From</th><th>To</th><th>Status</th></tr></thead>
    <tbody>${(d.list||[]).map(r=>`<tr><td><b>${esc(r.full_name)}</b></td><td>${esc(r.leave_type)}</td><td>${fmtDate(r.start_date)}</td><td>${fmtDate(r.end_date)}</td><td>${pill(r.status)}</td></tr>`).join('')||'<tr><td colspan="5" class="empty">No leave requests</td></tr>'}</tbody></table></div>`;
}

/* ---------- OVERTIME ---------- */
async function viewOT(){
  const d=await get('overtime');
  $('#view').innerHTML=`<div class="card"><h3 style="margin-bottom:12px;color:#37455e">⏰ Overtime</h3>
    <table><thead><tr><th>Date</th><th>Employee</th><th>Dept</th><th>OT (min)</th></tr></thead>
    <tbody>${(d.list||[]).map(r=>`<tr><td>${fmtDate(r.work_date)}</td><td><b>${esc(r.full_name)}</b></td><td>${esc(r.dept||'-')}</td><td style="color:#6c5ce7;font-weight:700">${r.overtime_minutes}</td></tr>`).join('')||'<tr><td colspan="4" class="empty">No overtime</td></tr>'}</tbody></table></div>`;
}

/* ---------- EXCEPTIONS ---------- */
async function viewExc(){
  const d=await get('exceptions');
  $('#view').innerHTML=`<div class="card"><h3 style="margin-bottom:12px;color:#37455e">⚠️ Exceptions</h3>
    <table><thead><tr><th>Employee</th><th>Type</th><th>Date</th><th>Status</th><th></th></tr></thead>
    <tbody>${(d.list||[]).map(r=>`<tr><td><b>${esc(r.full_name)}</b></td><td>${esc(r.exception_type)}</td><td>${fmtDate(r.work_date)}</td><td>${pill(r.status)}</td>
      <td>${r.status==='Pending'?`<button class="btn sm green" onclick="resExc(${r.id})">Approve</button>`:'—'}</td></tr>`).join('')||'<tr><td colspan="5" class="empty">No exceptions</td></tr>'}</tbody></table></div>`;
}
async function resExc(id){await post('resolve_exception',{id,status:'Approved'});viewExc();}

/* ---------- CORRECTIONS ---------- */
async function viewCorr(){
  const d=await get('corrections');
  $('#view').innerHTML=`<div class="card"><h3 style="margin-bottom:12px;color:#37455e">🛠️ Attendance Corrections</h3>
    <table><thead><tr><th>Employee</th><th>Old In→Out</th><th>New In→Out</th><th>Reason</th><th>Status</th></tr></thead>
    <tbody>${(d.list||[]).map(r=>`<tr><td><b>${esc(r.full_name)}</b></td>
      <td>${fmtDT(r.old_clock_in)} → ${fmtDT(r.old_clock_out)}</td>
      <td>${r.new_clock_in?fmtDT(r.new_clock_in):'-'} → ${r.new_clock_out?fmtDT(r.new_clock_out):'-'}</td>
      <td>${esc(r.reason||'-')}</td><td>${pill(r.status)}</td></tr>`).join('')||'<tr><td colspan="5" class="empty">No corrections</td></tr>'}</tbody></table></div>`;
}

/* ---------- ANALYTICS ---------- */
async function viewAna(){
  $('#view').innerHTML='<p class="empty">Loading analytics...</p>';
  const d=await get('analytics');
  $('#view').innerHTML=`
    <div class="stat-card" style="margin-bottom:18px"><div class="lbl">Overall Attendance Rate</div><div class="val" style="color:#6c5ce7">${d.rate}%</div></div>
    <div class="grid g2">
      <div class="card"><h3 style="margin-bottom:14px;color:#37455e">Daily Attendance</h3><canvas id="anaChart" height="130"></canvas></div>
      <div class="card"><h3 style="margin-bottom:14px;color:#37455e">Department Comparison</h3><canvas id="deptChart" height="130"></canvas></div>
    </div>`;
  new Chart($('#anaChart'),{type:'line',data:{labels:(d.daily||[]).map(r=>r.work_date.slice(5)),datasets:[
    {label:'Present',data:(d.daily||[]).map(r=>r.present),borderColor:'#00b894',tension:.4},
    {label:'Late',data:(d.daily||[]).map(r=>r.late),borderColor:'#fdcb6e',tension:.4},
    {label:'Absent',data:(d.daily||[]).map(r=>r.absent),borderColor:'#ff7675',tension:.4}]},options:{scales:{y:{beginAtZero:true}}}});
  new Chart($('#deptChart'),{type:'bar',data:{labels:(d.depts||[]).map(r=>r.name),datasets:[
    {label:'Present',data:(d.depts||[]).map(r=>r.present),backgroundColor:'#00b894'},
    {label:'Late',data:(d.depts||[]).map(r=>r.late),backgroundColor:'#fdcb6e'},
    {label:'Absent',data:(d.depts||[]).map(r=>r.absent),backgroundColor:'#ff7675'}]},options:{scales:{y:{beginAtZero:true}}}});
}

/* ---------- REPORTS ---------- */
async function viewRep(){
  const d=await get('reports');
  $('#view').innerHTML=`<div class="card"><div class="filter-row">
      <input type="date" id="repFrom" value="${new Date().toISOString().slice(0,7)+'-01'}">
      <input type="date" id="repTo" value="${new Date().toISOString().slice(0,10)}">
      <button class="btn ghost" onclick="viewRep()">Refresh</button></div>
    <h3 style="margin-bottom:12px;color:#37455e">📄 Attendance Report</h3>
    <table><thead><tr><th>Employee</th><th>Code</th><th>Dept</th><th>Days Present</th><th>Late</th><th>OT (min)</th></tr></thead>
    <tbody>${(d.list||[]).map(r=>`<tr><td><b>${esc(r.full_name)}</b></td><td>${esc(r.employee_code)}</td><td>${esc(r.dept||'-')}</td><td>${r.days_present}</td><td>${r.late_days}</td><td>${r.overtime_min}</td></tr>`).join('')}</tbody></table></div>`;
}

/* ---------- SEARCH ---------- */
function viewSearch(){$('#view').innerHTML=`<div class="card"><h3 style="margin-bottom:12px">🔍 Search Attendance</h3><input id="sq" placeholder="Search employee name, code, dept..." style="margin-bottom:12px"><button class="btn" onclick="doSearch()">Search</button><div id="sr"></div></div>`;}
async function doSearch(){const q=$('#sq').value;if(!q)return;const d=await get('search',{q});$('#sr').innerHTML=`<table style="margin-top:14px"><thead><tr><th>Date</th><th>Employee</th><th>Dept</th><th>In</th><th>Out</th><th>Status</th></tr></thead><tbody>${(d.list||[]).map(r=>`<tr><td>${fmtDate(r.work_date)}</td><td><b>${esc(r.full_name)}</b></td><td>${esc(r.dept||'-')}</td><td>${r.clock_in?fmtDT(r.clock_in):'-'}</td><td>${r.clock_out?fmtDT(r.clock_out):'-'}</td><td>${pill(r.status)}</td></tr>`).join('')||'<tr><td colspan="6" class="empty">No results</td></tr>'}</tbody></table>`;}

/* ---------- NOTIFICATIONS ---------- */
async function viewNotif(){const d=await get('notifications');$('#view').innerHTML=`<div class="card"><h3 style="margin-bottom:12px">🔔 Notifications</h3>${(d.list||[]).map(n=>`<div style="padding:10px 0;border-bottom:1px solid #f0f2f8"><b>${esc(n.title)}</b><br><span style="color:#8a97ab;font-size:13px">${esc(n.message)} · ${fmtDT(n.created_at)}</span></div>`).join('')||'<p class="empty">No notifications</p>'}</div>`;}

/* ---------- CLOCKING MACHINE ---------- */
async function viewMachine(){const d=await get('clocking_machine');$('#view').innerHTML=`<div class="grid g2">
  <div class="stat"><div class="ic">🔌</div><div class="lbl">Device</div><div class="val" style="font-size:18px">${esc(d.device)}</div><div style="color:#00b894;margin-top:6px">● Connected</div></div>
  <div class="stat"><div class="ic">📟</div><div class="lbl">Source of raw transactions</div><div class="val" style="font-size:18px">${(d.records||[]).map(r=>esc(r.status)+': '+r.c).join(' · ')}</div></div></div>
  <div class="card"><p style="color:#8a97ab;line-height:1.7">The clocking machine remains the <b>source of raw clocking transactions</b>. This app processes and calculates attendance from those transactions but never silently alters the original machine records — preserving the audit trail.</p></div>`;}

/* ---------- SYNC ---------- */
async function viewSync(){$('#view').innerHTML=`<div class="card" style="text-align:center;padding:40px"><h3 style="margin-bottom:10px">🔄 Synchronization</h3><p style="color:#8a97ab;margin-bottom:18px">Sync clocking machine transactions to the attendance engine.</p><button class="btn" onclick="doSync()"><i class="fa-solid fa-rotate"></i> Sync Now</button><div id="syncR" style="margin-top:16px"></div></div>`;}
async function doSync(){const d=await post('sync');$('#syncR').innerHTML=`<p style="color:#00b894">✓ Synced ${d.synced} machine records</p>`;}

/* ---------- AUDIT ---------- */
async function viewAudit(){const d=await get('audit_log');$('#view').innerHTML=`<div class="card"><h3 style="margin-bottom:12px">📜 Audit Log</h3><table><thead><tr><th>Time</th><th>User</th><th>Action</th><th>Details</th></tr></thead><tbody>${(d.list||[]).map(r=>`<tr><td>${fmtDT(r.created_at)}</td><td>${esc(r.username||'-')}</td><td>${esc(r.action)}</td><td>${esc(r.details)}</td></tr>`).join('')}</tbody></table></div>`;}

/* ---------- USERS ---------- */
async function viewUsers(){const d=await get('users');$('#view').innerHTML=`<div class="card"><h3 style="margin-bottom:12px">👥 Users & Permissions</h3><table><thead><tr><th>User</th><th>Role</th><th>Status</th></tr></thead><tbody>${(d.list||[]).map(u=>`<tr><td><b>${esc(u.full_name)}</b> <span style="color:#8a97ab;font-size:12px">@${esc(u.username)}</span></td><td>Role #${u.role_id}</td><td>${pill(u.status)}</td></tr>`).join('')}</tbody></table></div>`;}

/* ---------- SETTINGS ---------- */
async function viewSettings(){const d=await get('settings');$('#view').innerHTML=`<div class="card"><h3 style="margin-bottom:12px">⚙️ Settings</h3><table><thead><tr><th>Key</th><th>Value</th></tr></thead><tbody>${(d.list||[]).map(s=>`<tr><td><b>${esc(s.setting_key||s.key||'-')}</b></td><td>${esc(s.setting_value||s.value||'-')}</td></tr>`).join('')||'<tr><td colspan="2" class="empty">No settings configured</td></tr>'}</tbody></table></div>`;}

/* ---------- MODAL ---------- */
function openModal(html){const m=document.createElement('div');m.className='modal-bg';m.id='mdl';m.innerHTML=`<div class="modal">${html}</div>`;m.onclick=e=>{if(e.target===m)closeModal();};document.body.appendChild(m);}
function closeModal(){const m=$('#mdl');if(m)m.remove();}

/* ---------- DATA ---------- */
async function generateData(){if(!confirm('Generate 2 weeks of sample attendance data for all active employees?'))return;await post('generate_data');alert('Sample data generated');nav('dashboard');}

/* init */
async function init(){await get('employees').catch(()=>{});viewDash();}
init();
</script>
</body>
