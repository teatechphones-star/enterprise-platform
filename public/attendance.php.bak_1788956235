            } elseif(strpos($qt,'summary')!==false||strpos($qt,'report')!==false){
                $rows=q("SELECT COUNT(DISTINCT employee_id) c FROM attendance_records WHERE work_date=? AND status IN ('Present','Late','Overtime')",'s',[$today]);
                $present=$rows[0]['c'];
                echo json_encode(['ok'=>true,'title'=>'Daily Attendance Summary','response'=>$present." employees present today.","report"=>true]); 
                audit('ai_ask','Attendance',"Q: $q"); break;
            } elseif(strpos($qt,'compare')!==false){
                $m1=q("SELECT COUNT(DISTINCT employee_id) c FROM attendance_records WHERE MONTH(work_date)=MONTH(CURDATE()) AND status IN ('Present','Late','Overtime') AND YEAR(work_date)=YEAR(CURDATE())")[0]['c'];
                $prev=date('m',strtotime('first day of last month'));
                $m2=q("SELECT COUNT(DISTINCT employee_id) c FROM attendance_records WHERE MONTH(work_date)=? AND status IN ('Present','Late','Overtime') AND YEAR(work_date)=YEAR(CURDATE())",'s',[$prev])[0]['c'];
                $title="Month comparison";
                $resp="This month distinct employee-days present: $m1. Last month: $m2.";
                $rows=null;
            } else {
                $title="Attendance Assistant";
                $resp="I can answer questions about absences, lateness, department trends, attendance rate, and generate reports. Try: 'Who is absent today?', 'Who arrived late?', 'Show attendance problems this week'.";
            }
            if($rows!==null) $resp.=" ".implode(', ',array_map(function($r){return isset($r['full_name'])?$r['full_name']:(isset($r['dept'])?$r['dept']:'');},$rows));
            audit('ai_ask','Attendance',"Q: $q");
            echo json_encode(['ok'=>true,'title'=>$title,'response'=>$resp]); break;

        default:
            echo json_encode(['error'=>'Unknown action']);
    }
    } catch (Exception $e) {
        echo json_encode(['error'=>$e->getMessage()]);
    }
    exit;
}

