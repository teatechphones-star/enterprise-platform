function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function fmtDate(d){if(!d)return '-';const x=new Date(d);if(isNaN(x))return d;return String(x.getDate()).padStart(2,'0')+'/'+String(x.getMonth()+1).padStart(2,'0')+'/'+x.getFullYear();}
function fmtDT(d){if(!d)return '-';const x=new Date(d);if(isNaN(x))return d;return fmtDate(d)+' '+String(x.getHours()).padStart(2,'0')+':'+String(x.getMinutes()).padStart(2,'0');}
function pill(s){const m={Present:'green',Late:'amber',Absent:'red','On Leave':'blue',Overtime:'purple',Active:'green',Approved:'green',Pending:'amber',Rejected:'red',Deactivated:'red'};return `<span class="pill ${m[s]||'violet'}">${esc(s)}</span>`;}
async function get(action,params={}){
  const url='?page=api&action='+action+(params.q?'&q='+encodeURIComponent(params.q):'')+(params.from?'&from='+params.from:'')+(params.to?'&to='+params.to:'')+(params.date?'&date='+params.date:'');
  try{const r=await fetch(url);const d=await r.json();if(d.error)throw new Error(d.error);return d;}catch(e){alert('Request failed: '+e.message);throw e;}
}
async function post(action,data={}){
  const f=new URLSearchParams(data);
  const r=await fetch('?page=api&action='+action,{method:'POST',body:f});
  const d=await r.json();if(d.error)throw new Error(d.error);return d;
}
